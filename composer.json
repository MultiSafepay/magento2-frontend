{
    "name": "multisafepay/magento2-frontend",
    "description": "MultiSafepay frontend module for Magento 2",
    "version": "3.2.1",
    "require": {
        "multisafepay/magento2-core": "^3.21",
        "multisafepay/magento2-adminhtml": "^1.39",
        "magento/framework": "^102.0|^103.0",
        "magento/module-checkout": "^100.0",
        "magento/module-quote": "^101.0",
        "magento/module-sales": "^102.0|^103.0",
        "magento/module-store": "^101.0"
    },
    "type": "magento2-module",
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MultiSafepay\\ConnectFrontend\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
